+            "Volume C: serial",
+            "Volume Serial Number is 406F-727A",
+            "Volume Serial Number is DEAD-BEEF",
+            true,
+            true,
+        );
+        let c = checks.first().unwrap();
+        assert_eq!(c.status, FieldStatus::Changed);
+        assert!(!c.note.contains("boot sector"));
+    }
