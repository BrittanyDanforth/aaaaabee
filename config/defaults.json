  "prediction_enabled": true,
  "prediction_lead_seconds": 0.045,
  "prediction_max_pixels": 28,
  "humanize_enabled": false,
  "humanize_amplitude_pixels": 0.0,
  "humanize_jerk_limit": 0.0,
  "target_stickiness_pixels": 60,
  "target_lost_frames_before_unlock": 12,
  "distance_score_weight": 2.0,
  "area_score_weight": 0.015,
  "min_target_area_pixels": 20,
  "humanoid_min_height_pixels": 16,
