  "mouse_gate_pull_budget_scale": 3.5,
  "trace_pull": false,
  "trace_pull_console": true,
  "trace_pull_log_file": "logs/pull_trace.log",
  "trace_pull_interval_frames": 1,
  "trace_pull_max_frames": 900,
  "enable_hooks": false,
  "hsv_ranges": [
    {
      "lower": [0, 80, 80],
      "upper": [15, 255, 255],
      "comment": "red highlight low-mid saturation"
    },
    {
      "lower": [165, 80, 80],
      "upper": [179, 255, 255],
      "comment": "red hue wrap (magenta-red)"
    }
  ]
