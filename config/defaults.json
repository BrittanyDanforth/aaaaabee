{
  "profile": "apex_style_live_safe",
  "dry_run": false,
  "allow_live_mouse": false,
  "offline_dev_mode": false,
  "target_process_name": "",
  "target_window_title": "",
  "target_process_required": false,
  "pause_on_target_closed": true,
